# === Alpaca API pristupove udaje ===
# Vygenerujte na https://app.alpaca.markets (paper i live klice se generuji zvlast)
ALPACA_API_KEY=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key

# true = paper trading (virtualni penize, VZDY zacinejte tady)
# false = live trading (skutecne penize) - vyzaduje navic I_UNDERSTAND_LIVE_TRADING_RISK=true
ALPACA_PAPER=true

# Bezpecnostni pojistka pro ostry provoz - musi byt explicitne nastavena na true,
# jinak scripts/run_live.py odmitne spustit obchodovani s ALPACA_PAPER=false
I_UNDERSTAND_LIVE_TRADING_RISK=false

# === Sledovane symboly (oddelene carkou) ===
SYMBOLS=AAPL,MSFT,SPY,QQQ,AMZN

# === Timeframe svicek ===
# Pocet minut na jednu svicku (1, 5, 15, 30, 60...)
TIMEFRAME_MINUTES=5

# Kolik svicek drzet v rolling bufferu pro vypocet indikatoru
BAR_LOOKBACK=300

# Za kolik svicek dopredu se vyhodnocuje smer (label pro self-learning model)
PREDICTION_HORIZON_BARS=3

# === Risk management ===
# Podil equity riskovany na jeden obchod (0.01 = 1 %)
RISK_PER_TRADE=0.01
# Max. podil equity v jednom symbolu (0.2 = 20 %)
MAX_POSITION_PCT=0.2
# Max. pocet soucasne otevrenych pozic
MAX_OPEN_POSITIONS=5
# Denni ztratovy limit -> po prekroceni se dalsi vstupy pozastavi do dalsiho dne
DAILY_LOSS_LIMIT_PCT=0.03
# Max. povoleny drawdown od maxima equity -> "circuit breaker" zastavi obchodovani
MAX_DRAWDOWN_PCT=0.15
# Nasobky ATR pro stop-loss / take-profit bracket ordery
ATR_STOP_MULTIPLIER=2.0
ATR_TAKE_PROFIT_MULTIPLIER=3.0
# Minimalni jistota signalu (0-1), pod kterou se obchod neprovede
MIN_CONFIDENCE=0.55
# Povolit short prodeje (short selling)
ALLOW_SHORT=false
# Povolit obchodovani mimo standardni seanci
EXTENDED_HOURS=false
# Max. doba drzeni pozice v poctu svicek, pote se pozice uzavre za trh (0 = vypnuto)
MAX_HOLD_BARS=0

# === Provoz agenta ===
# Interval hlavni smycky (kontrola rizika, health-check) v sekundach
LOOP_INTERVAL_SECONDS=30
# Jak casto (v minutach) ukladat stav modelu/banditu a equity snapshot na disk
PERSIST_INTERVAL_MINUTES=15
# Pokud true, zadny prikaz se skutecne neodesle na Alpaca (jen se loguje) - dalsi bezpecnostni sit navic k paper uctu
DRY_RUN=false
# Cesta k souboru, jehoz pouha existence okamzite pozastavi nove vstupy (rucni "nouzovy vypinac")
KILL_SWITCH_FILE=data/STOP
# Pri vypnuti agenta (Ctrl+C) take uzavrit vsechny otevrene pozice
CLOSE_POSITIONS_ON_SHUTDOWN=false

# === Cesty k datum/logum ===
MODEL_PATH=data/model_state.pkl
BANDIT_PATH=data/bandit_state.json
DB_PATH=data/trading_agent.db
LOG_DIR=data/logs
LOG_LEVEL=INFO
